# Copy to .env and fill in. Everything else has a working default.

# Port the driver uses for the local Chromium DevTools endpoint.
# Required in production: no
# Default: discovered from a running browser
PULSE_CDP_PORT=

# Directory Pulse writes its map and routine files into.
# Required in production: no
# Default: $XDG_STATE_HOME/pulse, or ~/.local/state/pulse
PULSE_STATE_DIR=

# Binary the computer-use driver shells out to.
# Required in production: no
# Default: computer-use-linux on PATH
PULSE_COMPUTER_USE_BIN=

# Set by a nested computer-use invocation. Pulse refuses to recurse when this
# is present. Do not set it by hand.
# Required in production: no
CUL_NESTED=

# Sway and XDG sets these. Pulse reads them to locate the session, and a wrong
# value makes it map the wrong display. Do not set them by hand.
# Required in production: no
SWAYSOCK=
XDG_STATE_HOME=
